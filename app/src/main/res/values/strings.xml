    <string name="intro_sem_titulo">El semáforo de la semana</string>
    <string name="intro_sem_sub">Mira de un vistazo cómo va cada día.</string>
    <string name="intro_sem_verde">Todo cubierto</string>
    <string name="intro_sem_verde_d">Sin preocupaciones</string>
    <string name="intro_sem_ambar">Hay avisos</string>
    <string name="intro_sem_ambar_d">Revisa los detalles</string>
    <string name="intro_sem_rojo">Hay huecos</string>
    <string name="intro_sem_rojo_d">Necesita tu atención</string>
    <string name="intro_sem_consejo">La app cruza las actividades de los niños con la disponibilidad de cada persona y te avisa de lo que necesita organización.</string>
    <string name="intro_dia_titulo">El día, hora a hora</string>
    <string name="intro_dia_sub">Una línea de tiempo clara de todo lo que pasa en casa.</string>
    <string name="intro_dia_f1">Horario real</string>
    <string name="intro_dia_f1_d">Cada actividad en su hora exacta.</string>
    <string name="intro_dia_f2">Quién la lleva y quién la recoge</string>
    <string name="intro_dia_f2_d">Sin dudas ni mensajes de última hora.</string>
    <string name="intro_dia_f3">Huecos al instante</string>
    <string name="intro_dia_f3_d">Ves de un vistazo lo que falta por cubrir.</string>
    <string name="intro_disp_titulo">Cada cual, a lo suyo</string>
    <string name="intro_disp_sub">La disponibilidad de toda la familia en un solo lugar.</string>
    <string name="intro_disp_f1">Todos los compromisos en un solo lugar</string>
    <string name="intro_disp_f1_d">Trabajo, médico, viajes, vacaciones…</string>
    <string name="intro_disp_f2">Avisos automáticos</string>
    <string name="intro_disp_f2_d">%1$s detecta cuándo alguien no puede.</string>
    <string name="intro_disp_f3_d">Abuelos, canguros… cada uno con su calendario.</string>
    <string name="intro_avisos_titulo">Un aviso a tiempo</string>
    <string name="intro_avisos_sub">Recordatorios justo cuando los necesitas.</string>
