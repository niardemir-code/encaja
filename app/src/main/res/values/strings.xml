    <string name="intro_sem_consejo">La app cruza las actividades de los niños con la disponibilidad de cada persona y te avisa de lo que necesita organización.</string>
    <string name="intro_dia_titulo">El día, hora a hora</string>
    <string name="intro_dia_sub">Una línea de tiempo clara de todo lo que pasa en casa.</string>
